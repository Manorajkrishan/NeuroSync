# Copy to .env and replace every placeholder before a shared or public host.
# Never commit .env. The API reads these as environment variables.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Required. At least 32 characters. Not a dictionary word.
JWT_SIGNING_KEY=replace-this-with-a-unique-32-character-secret

POSTGRES_PASSWORD=replace-this-database-password
# Libpq connection string for the API container. Host is the compose service name "db".
# Use the same database password as POSTGRES_PASSWORD. Fill this only in .env.
NEUROSYNC_DB_CONNECTION=
NEUROSYNC_ORIGIN=https://localhost

# Invite-only beta. Set a private code, or set BETA_INVITE_ONLY=false on a machine only you use.
BETA_INVITE_ONLY=true
BETA_INVITE_CODE=replace-with-a-private-invite-code

# Optional scrape key for GET /api/ops/metrics
METRICS_KEY=

# LLM stays off until both values are set. The key must never be placed in the browser.
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional public hostname for Caddy automatic HTTPS. "localhost" uses Caddy's local certificate.
SITE_ADDRESS=localhost
