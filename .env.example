# Copy to NeuroSync.Api/appsettings.json or set as environment variables.
# NEVER commit real tokens.

Auth__RequireApiKey=true
Auth__ApiKey=change-me-to-a-long-random-string

# Comma-separated for Docker; JSON array in appsettings
# Cors__AllowedOrigins__0=https://your-demo.example.com

ConnectionStrings__DefaultConnection=

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Optional IoT (leave empty unless needed)
IoT__Spotify__ClientId=
IoT__Spotify__ClientSecret=
IoT__YouTubeMusic__ClientId=
IoT__YouTubeMusic__ClientSecret=
IoT__YouTubeMusic__ApiKey=
