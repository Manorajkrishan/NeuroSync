{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "NeuroSync": "Information"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "RequireApiKey": false,
    "RequireAuthentication": true,
    "Jwt": {
      "Issuer": "NeuroSync",
      "Audience": "NeuroSync",
      "SigningKey": "",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 14
    }
  },
  "Beta": {
    "InviteOnly": true,
    "InviteCodes": []
  },
  "Database": {
    "Provider": "Postgres",
    "ApplyMigrations": true,
    "RetentionDays": 365,
    "RetentionSweep": true
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Https": {
    "Redirect": false,
    "Hsts": true,
    "TrustProxy": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Companion": {
    "Llm": {
      "Enabled": false,
      "ApiKey": "",
      "BaseUrl": "https://api.openai.com/v1",
      "Model": "gpt-4o-mini",
      "TimeoutSeconds": 12,
      "MaxTokens": 280,
      "RetryCount": 2,
      "MinQualityScore": 0.65,
      "DailyCostLimitUsd": 5,
      "PerUserDailyRequests": 200,
      "InputPricePerMillionUsd": 0.15,
      "OutputPricePerMillionUsd": 0.60
    }
  },
  "Learning": {
    "AutoRetrain": false
  },
  "Ops": {
    "MetricsKey": ""
  }
}
